{
  "name": "library",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'bun run dev:web'",
    "dev:web": "vite dev --port 3000",
    "web:dev": "bun run dev:web",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install chromium",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "convex:dev": "convex dev",
    "convex:push": "convex dev --once",
    "secrets:import": "secrets-sync import",
    "secrets:check": "secrets-sync import --check",
    "secrets:audit": "secrets-sync audit dev",
    "secrets:export": "secrets-sync export dev",
    "secrets:publish": "secrets-sync export dev --apply",
    "convex:sync-env": "bun --env-file=.env.production.local scripts/sync-convex-env.ts",
    "convex:deploy": "deploy library --export-env .env.production.local && bun run convex:sync-env && bunx convex deploy --env-file .env.production.local",
    "deploy:dry-run": "deploy library --dry-run --yes",
    "deploy:sync-only": "deploy library --sync-only",
    "dokploy:list-apps": "deploy --help",
    "deploy": "bun run convex:deploy && deploy library"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@convex-dev/auth": "^0.0.92",
    "@faker-js/faker": "^10.0.0",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/router-plugin": "^1.132.0",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.39.1",
    "lucide-react": "^0.561.0",
    "nitro": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^3.6.3",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "ts-fsrs": "^5.4.1",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.1.11",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "^1.61.0",
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  }
}
